<UserControl x:Class="CCLite.Views.FanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,22,4">
        <StackPanel>

            <TextBlock Text="风扇" Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="CustomToggle" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      Checked="CustomToggle_Changed" Unchecked="CustomToggle_Changed"/>
                            <TextBlock Text="启用自定义风扇曲线" Margin="12,0,0,0" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="预设" Style="{StaticResource SecondaryText}" Margin="0,0,8,0"/>
                            <ComboBox x:Name="PresetCombo" Style="{StaticResource ModernCombo}" Width="130"
                                      SelectionChanged="Preset_SelectionChanged">
                                <ComboBoxItem Content="自定义 1"/>
                                <ComboBoxItem Content="自定义 2"/>
                                <ComboBoxItem Content="自定义 3"/>
                            </ComboBox>
                            <Button x:Name="BtnRestoreAuto" Style="{StaticResource StandardButton}" Margin="10,0,0,0"
                                    Content="恢复自动" Click="RestoreAuto_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="FanHintText" Style="{StaticResource SecondaryText}" Margin="0,10,0,0"
                               Text="关闭自定义时恢复 EC 自动调速。"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock x:Name="LiveCpuText" Text="CPU: --°C / -- RPM" Style="{StaticResource SecondaryText}" Margin="0,0,24,0"/>
                        <TextBlock x:Name="LiveGpuText" Text="GPU: --°C / -- RPM" Style="{StaticResource SecondaryText}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="温度 — 转速曲线（蓝色 CPU / 橙色 GPU）" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                    <Canvas x:Name="CurveCanvas" Height="190" Margin="0,12,0,0" Background="#232323"/>
                </StackPanel>
            </Border>

            <UniformGrid Columns="2">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="CPU 风扇曲线" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                        <TextBlock Text="温度点固定为 30–100°C 共 8 档，拖动滑条设定该温度下的转速百分比" Margin="0,4,0,6"
                                   Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                        <StackPanel x:Name="CpuSliderHost"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="GPU 风扇曲线" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                        <TextBlock Text="改动会自动保存到当前预设；启用自定义时立即下发到 EC" Margin="0,4,0,6"
                                   Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                        <StackPanel x:Name="GpuSliderHost"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
