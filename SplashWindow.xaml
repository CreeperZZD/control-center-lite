<Window x:Class="CCLite.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340" Height="190" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
        Background="#1F1F1F" AllowsTransparency="True">
    <Border BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="10" Background="#1F1F1F">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="8" Background="#2B3040" VerticalAlignment="Center">
                    <Path Data="M 12.6,2.3 L 6.1,13.1 L 10.5,13.1 L 8.9,20.1 L 16.4,9.8 L 11.9,9.8 Z"
                          Fill="#4CC2FF" Stretch="Uniform" Margin="4.5"/>
                </Border>
                <TextBlock Text="控制中心" Margin="12,0,0,0" FontSize="19" FontWeight="SemiBold"
                           Foreground="#FFFFFF" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="正在启动…" Margin="0,16,0,0" FontSize="13"
                       Foreground="#9D9D9D" HorizontalAlignment="Center"/>
            <ProgressBar x:Name="Progress" Width="200" Height="4" Margin="0,14,0,0"
                         Foreground="#4CC2FF" Background="#333333" BorderThickness="0"/>
        </StackPanel>
    </Border>
</Window>
