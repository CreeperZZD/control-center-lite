<UserControl x:Class="CCLite.Views.LightingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,22,4">
        <StackPanel>

            <TextBlock Text="灯光" Style="{StaticResource PageTitle}"/>

            <!-- 灯效档案 -->
            <Grid>
                <TextBlock Text="灯效档案（按系统模式自动联动）" Style="{StaticResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="选中模式灯效开关" Style="{StaticResource SecondaryText}" Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               ToolTip="只影响当前选中的系统模式；每个模式独立记忆开关状态，切换模式自动恢复"/>
                    <CheckBox x:Name="MasterToggle" Style="{StaticResource Switch}" VerticalAlignment="Center"
                              Checked="MasterToggle_Changed" Unchecked="MasterToggle_Changed"/>
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                <RadioButton x:Name="ChipFollow" Content="跟随当前模式" Style="{StaticResource Chip}" GroupName="LedProfile" IsChecked="True" Checked="Chip_Checked" Tag="-1"/>
                <RadioButton x:Name="ChipOffice" Content="办公" Style="{StaticResource Chip}" GroupName="LedProfile" Checked="Chip_Checked" Tag="2"/>
                <RadioButton x:Name="ChipGaming" Content="游戏" Style="{StaticResource Chip}" GroupName="LedProfile" Checked="Chip_Checked" Tag="1"/>
                <RadioButton x:Name="ChipPerf" Content="狂暴" Style="{StaticResource Chip}" GroupName="LedProfile" Checked="Chip_Checked" Tag="0"/>
                <RadioButton x:Name="ChipCustom" Content="自定义" Style="{StaticResource Chip}" GroupName="LedProfile" Checked="Chip_Checked" Tag="3"/>
            </StackPanel>
            <TextBlock x:Name="ProfileHintText" Style="{StaticResource SecondaryText}" Margin="2,8,0,0"
                       Text="编辑会实时写入键盘并保存到对应档案，与原版 Control Center 的灯光页互通"/>

            <!-- 键盘灯效预览 -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,12">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="键盘预览（点击 A/B/C 分区任意位置调色，自动切常亮防闪烁）" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PreviewEffectText" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}"/>
                    </Grid>
                    <Canvas x:Name="KeyboardPreview" Height="168" Margin="0,10,0,0" HorizontalAlignment="Left"
                            Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- 三分区统一颜色 -->
            <TextBlock Text="键盘分区" Style="{StaticResource SectionTitle}"/>
            <Border x:Name="NoRgbBanner" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="18"
                    Visibility="Collapsed">
                <TextBlock Text="本机键盘不带 RGB 灯光（SKUID 检测为非背光键盘）。" Style="{StaticResource BodyText}"/>
            </Border>
            <StackPanel x:Name="LedContentPanel">

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="三分区统一颜色" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="UnifiedHintText" Text="开启后三分区使用同一颜色，单独分区设置被屏蔽"
                                       Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="UnifiedSwatch" Style="{StaticResource SwatchButton}" Click="Swatch_Click"
                                    Tag="-1" ToolTip="选择统一颜色" Visibility="Collapsed"/>
                            <CheckBox x:Name="UnifiedToggle" Style="{StaticResource Switch}" Margin="14,0,0,0"
                                      Checked="Unified_Changed" Unchecked="Unified_Changed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Border.Resources>
                        <Style x:Key="ZoneRowHost" TargetType="Border">
                            <Setter Property="Margin" Value="0,0,0,12"/>
                        </Style>
                    </Border.Resources>
                    <StackPanel x:Name="ZoneRowsHost">
                        <Border x:Name="RowA" Style="{StaticResource ZoneRowHost}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="键盘 A 区" Style="{StaticResource BodyText}"/>
                                <Button x:Name="SwatchA" Grid.Column="1" Style="{StaticResource SwatchButton}" Click="Swatch_Click" Tag="0"/>
                                <TextBlock x:Name="HexA" Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource SecondaryText}"/>
                            </Grid>
                        </Border>
                        <Border x:Name="RowB" Style="{StaticResource ZoneRowHost}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="键盘 B 区" Style="{StaticResource BodyText}"/>
                                <Button x:Name="SwatchB" Grid.Column="1" Style="{StaticResource SwatchButton}" Click="Swatch_Click" Tag="1"/>
                                <TextBlock x:Name="HexB" Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource SecondaryText}"/>
                            </Grid>
                        </Border>
                        <Border x:Name="RowC" Style="{StaticResource ZoneRowHost}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="键盘 C 区" Style="{StaticResource BodyText}"/>
                                <Button x:Name="SwatchC" Grid.Column="1" Style="{StaticResource SwatchButton}" Click="Swatch_Click" Tag="2"/>
                                <TextBlock x:Name="HexC" Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource SecondaryText}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="灯效模式" Style="{StaticResource BodyText}"/>
                            <ComboBox x:Name="EffectCombo" Grid.Column="1" Style="{StaticResource ModernCombo}"
                                      Width="180" HorizontalAlignment="Left" SelectionChanged="Effect_SelectionChanged"/>
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="亮度" Style="{StaticResource BodyText}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton x:Name="BriOff" Content="熄灭" Style="{StaticResource Chip}" Tag="0" GroupName="Bri" Checked="BriLevel_Checked" ToolTip="熄灭档仍保留约 5% 底亮（EC 三档亮度特性）"/>
                                <RadioButton x:Name="BriMid" Content="50%" Style="{StaticResource Chip}" Tag="1" GroupName="Bri" Checked="BriLevel_Checked" Margin="8,0,0,0"/>
                                <RadioButton x:Name="BriFull" Content="100%" Style="{StaticResource Chip}" Tag="2" GroupName="Bri" Checked="BriLevel_Checked" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>



        </StackPanel>
    </ScrollViewer>

        <!-- 调色盘弹窗（StaysOpen=False：点外部自然收起，内部拖动不受影响） -->
        <Popup x:Name="ColorPopup" Placement="MousePoint" HorizontalOffset="10" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <Border Width="368" Background="#2E2E2E" CornerRadius="8" BorderBrush="#5A5A5A" BorderThickness="1"
                    Padding="16" Margin="6,0,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                        <Grid>
                            <TextBlock Text="调色盘" Style="{StaticResource BodyText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource CaptionButton}" Width="30" Height="26" FontSize="9"
                                    Content="&#xE8BB;" HorizontalAlignment="Right" Click="ColorPopupClose_Click"
                                    ToolTip="关闭"/>
                        </Grid>

                        <Grid Width="150" Height="150" Margin="0,10,0,0" HorizontalAlignment="Center">
                            <Image x:Name="WheelImage" Width="150" Height="150"
                                   MouseLeftButtonDown="Wheel_MouseDown" MouseMove="Wheel_MouseMove"
                                   MouseLeftButtonUp="Wheel_MouseUp"/>
                            <Canvas x:Name="WheelHandleLayer" IsHitTestVisible="False">
                                <Ellipse x:Name="WheelHandle" Width="16" Height="16" Stroke="#FFFFFF"
                                         StrokeThickness="3" Canvas.Left="67" Canvas.Top="67"/>
                            </Canvas>
                        </Grid>

                        <TextBlock Text="灯效模式" Style="{StaticResource SecondaryText}" Margin="0,10,0,0"/>
                        <WrapPanel Margin="0,6,0,0">
                            <RadioButton x:Name="PnlStatic" Content="常亮" Style="{StaticResource Chip}" Tag="1" GroupName="PanelEffect" Margin="0,0,6,6" Checked="PanelEffect_Checked"/>
                            <RadioButton x:Name="PnlBreath" Content="呼吸" Style="{StaticResource Chip}" Tag="3" GroupName="PanelEffect" Margin="0,0,6,6" Checked="PanelEffect_Checked"/>
                            <RadioButton x:Name="PnlCycle" Content="多彩循环" Style="{StaticResource Chip}" Tag="6" GroupName="PanelEffect" Margin="0,0,6,6" Checked="PanelEffect_Checked"/>
                            <RadioButton x:Name="PnlAmbi" Content="流光溢彩" Style="{StaticResource Chip}" Tag="7" GroupName="PanelEffect" Margin="0,0,6,6" Checked="PanelEffect_Checked"/>
                        </WrapPanel>

                        <TextBlock Text="常用颜色" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
                        <UniformGrid Columns="6" Margin="0,6,0,0">
                            <Button x:Name="P0" Style="{StaticResource SwatchButton}" Width="34" Height="34" Margin="4" Click="Preset_Click" Tag="#FF0000"/>
                            <Button x:Name="P1" Style="{StaticResource SwatchButton}" Width="34" Height="34" Margin="4" Click="Preset_Click" Tag="#FF7F00"/>
                            <Button x:Name="P2" Style="{StaticResource SwatchButton}" Width="34" Height="34" Margin="4" Click="Preset_Click" Tag="#FFFF00"/>
                            <Button x:Name="P3" Style="{StaticResource SwatchButton}" Width="34" Height="34" Margin="4" Click="Preset_Click" Tag="#00FF00"/>
                            <Button x:Name="P4" Style="{StaticResource SwatchButton}" Width="34" Height="34" Margin="4" Click="Preset_Click" Tag="#00FF7F"/>
                            <Button x:Name="P5" Style="{StaticResource SwatchButton}" Width="34" Height="34" Margin="4" Click="Preset_Click" Tag="#00FFFF"/>
                            <Button x:Name="P6" Style="{StaticResource SwatchButton}" Width="34" Height="34" Margin="4" Click="Preset_Click" Tag="#0000FF"/>
                            <Button x:Name="P7" Style="{StaticResource SwatchButton}" Width="34" Height="34" Margin="4" Click="Preset_Click" Tag="#7F00FF"/>
                            <Button x:Name="P8" Style="{StaticResource SwatchButton}" Width="34" Height="34" Margin="4" Click="Preset_Click" Tag="#FF00FF"/>
                            <Button x:Name="P9" Style="{StaticResource SwatchButton}" Width="34" Height="34" Margin="4" Click="Preset_Click" Tag="#FF6FA8"/>
                            <Button x:Name="P10" Style="{StaticResource SwatchButton}" Width="34" Height="34" Margin="4" Click="Preset_Click" Tag="#FFC0CB"/>
                            <Button x:Name="P11" Style="{StaticResource SwatchButton}" Width="34" Height="34" Margin="4" Click="Preset_Click" Tag="#FFFFFF"/>
                        </UniformGrid>

                        <TextBlock Text="精确 RGB" Style="{StaticResource SecondaryText}" Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="R" Width="20" Style="{StaticResource BodyText}"/>
                            <Slider x:Name="RS" Width="214" Style="{StaticResource ModernSlider}" Maximum="255" ValueChanged="RgbSlider_Changed"/>
                            <TextBlock x:Name="RV" Width="34" Margin="8,0,0,0" Style="{StaticResource SecondaryText}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="G" Width="20" Style="{StaticResource BodyText}"/>
                            <Slider x:Name="GS" Width="214" Style="{StaticResource ModernSlider}" Maximum="255" ValueChanged="RgbSlider_Changed"/>
                            <TextBlock x:Name="GV" Width="34" Margin="8,0,0,0" Style="{StaticResource SecondaryText}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="B" Width="20" Style="{StaticResource BodyText}"/>
                            <Slider x:Name="BS" Width="214" Style="{StaticResource ModernSlider}" Maximum="255" ValueChanged="RgbSlider_Changed"/>
                            <TextBlock x:Name="BV" Width="34" Margin="8,0,0,0" Style="{StaticResource SecondaryText}"/>
                        </StackPanel>

                        <Grid Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="PopupPreview" Width="26" Height="26" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PopupHexText" Margin="10,0,0,0" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox x:Name="HexInput" Width="70" Height="26" VerticalContentAlignment="Center"
                                         FontSize="12" Background="{StaticResource ControlBgBrush}" Foreground="{StaticResource TextBrush}"
                                         BorderBrush="#454545" KeyDown="HexInput_KeyDown" LostFocus="HexInput_LostFocus"/>
                                <Button x:Name="BtnApplyHex" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                                        Padding="10,4" FontSize="12" Content="应用" Click="BtnApplyHex_Click"/>
                            </StackPanel>
                        </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>

