<UserControl x:Class="CCLite.Views.SystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,22,4">
        <StackPanel>

            <TextBlock Text="系统" Style="{StaticResource PageTitle}"/>

            <TextBlock Text="显示输出模式（切换后需重启生效）" Style="{StaticResource SectionTitle}"/>
            <UniformGrid Columns="3">
                <RadioButton x:Name="DispHybrid" Style="{StaticResource ModeCard}" Margin="0,0,10,0" Checked="DispCard_Checked" Tag="1">
                    <StackPanel>
                        <TextBlock Text="混合输出" Style="{StaticResource BodyText}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="独显渲染、核显输出，功耗与兼容性均衡" Margin="0,6,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="DispDiscrete" Style="{StaticResource ModeCard}" Margin="10,0" Checked="DispCard_Checked" Tag="2">
                    <StackPanel>
                        <TextBlock Text="独显直连" Style="{StaticResource BodyText}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="4070 直接驱动屏幕，游戏帧率最高" Margin="0,6,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="DispUma" Style="{StaticResource ModeCard}" Margin="10,0,0,0" Checked="DispCard_Checked" Tag="3">
                    <StackPanel>
                        <TextBlock Text="集显输出" Style="{StaticResource BodyText}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="关闭独显，续航最长（外接屏不支持）" Margin="0,6,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </RadioButton>
            </UniformGrid>
            <TextBlock x:Name="DispHintText" Style="{StaticResource SecondaryText}" Margin="2,8,0,0"
                       Text="与原版相同的 BIOS 级切换流程：确认 → 写入 EC → 重启后生效"/>

            <TextBlock Text="键盘与其他" Style="{StaticResource SectionTitle}"/>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Win 键锁定" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                        <TextBlock Text="游戏中临时屏蔽左 Win 键，防止误按弹回桌面" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="WinKeyToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                              VerticalAlignment="Center" Checked="WinKey_Changed" Unchecked="WinKey_Changed"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="开机自启" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AutoStartHint" Text="通过任务计划程序以最高权限随登录启动（保持风扇曲线与灯效联动后台生效）"
                                   Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="AutoStartToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                              VerticalAlignment="Center" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="诊断信息" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DiagText" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
