<Window x:Class="CCLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="控制中心" Height="680" Width="1020" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource WindowBgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#3A3A3A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== 标题栏 ===== -->
            <Grid Grid.Row="0" Background="{StaticResource NavBgBrush}">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Path Data="M 12.6,2.3 L 6.1,13.1 L 10.5,13.1 L 8.9,20.1 L 16.4,9.8 L 11.9,9.8 Z"
                          Fill="#4CC2FF" Stretch="Uniform" Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock Text="控制中心" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="BtnMinimize_Click"/>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <!-- ===== 主体：左侧导航 + 内容 ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="212"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource NavBgBrush}" Padding="0,10,0,10">
                    <Grid>
                        <!-- 滑动指示器（选中高亮块 + 蓝条） -->
                        <Canvas x:Name="NavIndicatorLayer" IsHitTestVisible="False">
                            <Border x:Name="NavIndicator" Width="196" Height="40" CornerRadius="6"
                                    Background="#1FFFFFFF" Canvas.Left="8"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="NavIndicatorShift" Y="0"/>
                                </Border.RenderTransform>
                                <Border x:Name="Pill" Width="3" Height="18" CornerRadius="1.5"
                                        Background="{StaticResource AccentBrush}" HorizontalAlignment="Left"
                                        Margin="-6,0,0,0" VerticalAlignment="Center"/>
                            </Border>
                        </Canvas>

                        <StackPanel>
                            <RadioButton x:Name="NavOverview" Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="概览"
                                         GroupName="Nav" IsChecked="True" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavLighting" Style="{StaticResource NavButton}" Tag="&#xE790;" Content="灯光"
                                         GroupName="Nav" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavFan" Style="{StaticResource NavButton}" Tag="&#xE9F9;" Content="风扇"
                                         GroupName="Nav" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavSystem" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="系统"
                                         GroupName="Nav" Checked="Nav_Checked"/>

                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="20,14,20,10"/>
                            <TextBlock x:Name="FooterText" Margin="22,0,16,0" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                       Text="与原版 Control Center 共存&#x0A;配置互相打通"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" BorderThickness="0" ClipToBounds="True">
                    <ContentControl x:Name="PageHost" Margin="30,18,10,14" Focusable="False" HorizontalContentAlignment="Stretch"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
