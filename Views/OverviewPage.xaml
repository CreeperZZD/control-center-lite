<UserControl x:Class="CCLite.Views.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,22,4">
        <StackPanel>

            <TextBlock Text="系统模式" Style="{StaticResource PageTitle}"/>

            <UniformGrid Columns="3">
                <RadioButton x:Name="CardOffice" Style="{StaticResource ModeCard}" Margin="0,0,10,0" Checked="ModeCard_Checked" Tag="2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="办公模式" Margin="10,0,0,0" Style="{StaticResource BodyText}" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="静音优先，性能适中，续航最好" Margin="0,6,0,0" Style="{StaticResource SecondaryText}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="CardGaming" Style="{StaticResource ModeCard}" Margin="10,0" Checked="ModeCard_Checked" Tag="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="游戏模式" Margin="10,0,0,0" Style="{StaticResource BodyText}" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="性能与噪音均衡，适合日常游戏" Margin="0,6,0,0" Style="{StaticResource SecondaryText}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="CardPerf" Style="{StaticResource ModeCard}" Margin="10,0,0,0" Checked="ModeCard_Checked" Tag="0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="狂暴模式" Margin="10,0,0,0" Style="{StaticResource BodyText}" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="全性能释放，风扇全速，噪音较大" Margin="0,6,0,0" Style="{StaticResource SecondaryText}"/>
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <TextBlock Text="显示与声音" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="屏幕亮度" Style="{StaticResource BodyText}"/>
                        <TextBlock Grid.Column="1" Text="&#xE706;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Slider x:Name="BrightnessSlider" Grid.Column="2" Style="{StaticResource ModernSlider}"
                                Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="Brightness_ValueChanged"/>
                        <TextBlock x:Name="BrightnessText" Grid.Column="3" HorizontalAlignment="Right"
                                   Style="{StaticResource SecondaryText}" Text="--"/>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="系统音量" Style="{StaticResource BodyText}"/>
                        <TextBlock Grid.Column="1" Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Slider x:Name="VolumeSlider" Grid.Column="2" Style="{StaticResource ModernSlider}"
                                Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="Volume_ValueChanged"/>
                        <TextBlock x:Name="VolumeText" Grid.Column="3" HorizontalAlignment="Right"
                                   Style="{StaticResource SecondaryText}" Text="--"/>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="静音" Style="{StaticResource BodyText}" FontSize="12.5" VerticalAlignment="Center"
                                       ToolTip="静音：开启后系统整体无声"/>
                            <CheckBox x:Name="MuteToggle" Style="{StaticResource Switch}" Margin="8,0,0,0"
                                      Checked="Mute_Changed" Unchecked="Mute_Changed" ToolTip="静音：开启后系统整体无声"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="AvHintText" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Text="硬件状态" Style="{StaticResource SectionTitle}"/>

            <UniformGrid Columns="2">
                <Border Style="{StaticResource Card}" Margin="0,0,10,12">
                    <StackPanel>
                        <TextBlock Text="CPU" Style="{StaticResource SecondaryText}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock x:Name="CpuTempText" Text="--°C" Style="{StaticResource StatValue}"/>
                            <TextBlock x:Name="CpuLoadText" Text="--" Margin="12,4,0,0" Style="{StaticResource SecondaryText}"/>
                        </StackPanel>
                        <TextBlock x:Name="CpuFanText" Text="风扇 -- RPM" Margin="0,4,0,0" Style="{StaticResource SecondaryText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="10,0,0,12">
                    <StackPanel>
                        <TextBlock Text="GPU" Style="{StaticResource SecondaryText}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock x:Name="GpuTempText" Text="--°C" Style="{StaticResource StatValue}"/>
                        </StackPanel>
                        <TextBlock x:Name="GpuFanText" Text="风扇 -- RPM" Margin="0,4,0,0" Style="{StaticResource SecondaryText}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="内存" Style="{StaticResource BodyText}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="DDR5-4800" Margin="0,0,10,0" Style="{StaticResource SecondaryText}"/>
                            <TextBlock x:Name="RamDetailText" Style="{StaticResource SecondaryText}"/>
                        </StackPanel>
                    </Grid>
                    <ProgressBar x:Name="RamBar" Style="{StaticResource ModernProgress}" Margin="0,8,0,0" Maximum="100"/>
                    <TextBlock x:Name="RamPctText" Style="{StaticResource SecondaryText}" Margin="0,5,0,0"/>

                    <Grid Margin="0,16,0,0">
                        <TextBlock Text="存储" Style="{StaticResource BodyText}"/>
                    </Grid>
                    <StackPanel x:Name="DiskHost" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Grid>
                <TextBlock Text="本机配置" Style="{StaticResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnCfgEdit" Style="{StaticResource StandardButton}" Padding="10,4" FontSize="12"
                            Content="编辑" Click="CfgEdit_Click"/>
                    <Button x:Name="BtnCfgSave" Style="{StaticResource AccentButton}" Padding="10,4" FontSize="12"
                            Content="保存" Margin="8,0,0,0" Click="CfgSave_Click" Visibility="Collapsed"/>
                    <Button x:Name="BtnCfgCancel" Style="{StaticResource StandardButton}" Padding="10,4" FontSize="12"
                            Content="取消" Margin="8,0,0,0" Click="CfgCancel_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="型号" Style="{StaticResource SecondaryText}" Margin="0,0,26,0"/>
                    <TextBlock x:Name="CfgModelT" Grid.Row="0" Grid.Column="1" Style="{StaticResource BodyText}"/>
                    <TextBox x:Name="CfgModel" Grid.Row="0" Grid.Column="1" Height="26" FontSize="13" Padding="6,2"
                             Background="{StaticResource ControlBgBrush}" Foreground="{StaticResource TextBrush}"
                             BorderBrush="#454545" Visibility="Collapsed"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="屏幕" Style="{StaticResource SecondaryText}"/>
                    <TextBlock x:Name="CfgScreenT" Grid.Row="1" Grid.Column="1" Style="{StaticResource BodyText}"/>
                    <TextBox x:Name="CfgScreen" Grid.Row="1" Grid.Column="1" Height="26" FontSize="13" Padding="6,2"
                             Background="{StaticResource ControlBgBrush}" Foreground="{StaticResource TextBrush}"
                             BorderBrush="#454545" Visibility="Collapsed"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="处理器" Style="{StaticResource SecondaryText}"/>
                    <TextBlock x:Name="CfgCpuT" Grid.Row="2" Grid.Column="1" Style="{StaticResource BodyText}"/>
                    <TextBox x:Name="CfgCpu" Grid.Row="2" Grid.Column="1" Height="26" FontSize="13" Padding="6,2"
                             Background="{StaticResource ControlBgBrush}" Foreground="{StaticResource TextBrush}"
                             BorderBrush="#454545" Visibility="Collapsed"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="显卡" Style="{StaticResource SecondaryText}"/>
                    <TextBlock x:Name="CfgGpuT" Grid.Row="3" Grid.Column="1" Style="{StaticResource BodyText}"/>
                    <TextBox x:Name="CfgGpu" Grid.Row="3" Grid.Column="1" Height="26" FontSize="13" Padding="6,2"
                             Background="{StaticResource ControlBgBrush}" Foreground="{StaticResource TextBrush}"
                             BorderBrush="#454545" Visibility="Collapsed"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="内存" Style="{StaticResource SecondaryText}"/>
                    <TextBlock x:Name="CfgRamT" Grid.Row="4" Grid.Column="1" Style="{StaticResource BodyText}"/>
                    <TextBox x:Name="CfgRam" Grid.Row="4" Grid.Column="1" Height="26" FontSize="13" Padding="6,2"
                             Background="{StaticResource ControlBgBrush}" Foreground="{StaticResource TextBrush}"
                             BorderBrush="#454545" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Border x:Name="BatteryWarnBanner" Background="#33FF7A7A" CornerRadius="8" Padding="14,10" Margin="0,6,0,0"
                    Visibility="Collapsed">
                <TextBlock Text="当前使用电池供电：游戏/狂暴模式已被禁用（与原版行为一致），请插电后使用。"
                           Style="{StaticResource BodyText}" FontSize="12.5" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
